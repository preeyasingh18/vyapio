# ============================================================================
# VYAPIO — environment configuration
#
# Copy to `.env` and fill in. `.env` is git-ignored and must NEVER be committed.
#
#   cp .env.example .env
#
# Vyapio starts and runs with NONE of these set. Every AWS-backed subsystem has
# a local adapter, and the app shows a "Local mode" badge so a local write is
# never mistaken for a write that reached AWS. Fill a section in to switch that
# one subsystem over to real AWS — they flip independently.
#
# One .env at the repository root serves both sides:
#   backend/src/config/index.ts   (server — may hold secrets)
#     loaded by  tsx --env-file-if-exists=../.env   (see backend/package.json)
#   frontend/src/app/config       (browser — VITE_* only, NEVER secrets)
#     loaded by  Vite, via  envDir: '..'            (see frontend/vite.config.ts)
#
# Vite only ever exposes VITE_-prefixed names to the browser, so the server
# values below stay out of the bundle even though they share this file.
# ============================================================================


# ─────────────────────────────────────────────────────────────────────────
#  ⚠ QUOTE ANY VALUE CONTAINING  #  OR A SPACE
#
#  Node's env-file parser treats an unquoted # as the start of a comment:
#
#      DEMO_PASSWORD=VyapioDemo#2024     →  "VyapioDemo"     ✗ silently cut
#      DEMO_PASSWORD="VyapioDemo#2024"   →  "VyapioDemo#2024" ✓
#
#  AWS secret keys and WhatsApp tokens often contain #, / and +.
#  When in doubt, wrap the value in double quotes.
# ─────────────────────────────────────────────────────────────────────────


# ---------------------------------------------------------------------------
# FRONTEND (browser)
#
# WARNING: everything prefixed VITE_ is inlined into the JavaScript bundle and
# is PUBLIC. Never put an access key, client secret or password here.
# ---------------------------------------------------------------------------

# Base URL of the backend API. Local dev proxies /api through Vite, so the
# default empty value is correct locally. After deploy, set the API Gateway URL.
VITE_API_URL=

# Public Cognito identifiers (safe to expose — they are not credentials).
# Leave both empty unless USER_POOL_ID / USER_POOL_CLIENT_ID below are also set:
# a browser advertising a pool the backend does not use is worse than no value.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_AWS_REGION=ap-south-1

# Shows the "Try the demo shop" entry point on the landing page.
VITE_DEMO_MODE=true

# Where the Vite dev server proxies /api. Only used by `npm run dev`; it never
# reaches the browser bundle. Defaults to the local API server.
VITE_DEV_API=http://localhost:4000


# ---------------------------------------------------------------------------
# BACKEND — core
# ---------------------------------------------------------------------------

# dev | staging | prod. Drives log verbosity and CORS strictness.
STAGE=dev

# Region for the data plane (DynamoDB, S3, EventBridge, SNS, Cognito).
AWS_REGION=ap-south-1

# Comma-separated origins allowed to call the API. Local dev defaults to the
# Vite dev server. In prod set this to your CloudFront domain only.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# debug | info | warn | error
LOG_LEVEL=info

# Optional limits. The defaults shown are what the code falls back to, so you
# only need these to override one.
# Requests per minute per identity, enforced in-process per container.
RATE_LIMIT_PER_MINUTE=120
# Largest accepted request body, in bytes. Checked before buffering.
MAX_BODY_BYTES=1000000
# Lifetime of a session token, in seconds. Default is 12 hours.
SESSION_TTL_SECONDS=43200

# Local API server bind address (backend/src/local-server.ts). The Vite dev
# proxy targets http://localhost:4000, so change both or neither.
PORT=4000
HOST=0.0.0.0

# Directory for the file-backed local store. Only used when DYNAMODB_TABLE_NAME
# is empty. Git-ignored.
LOCAL_DATA_DIR=.vyapio-data


# ---------------------------------------------------------------------------
# DYNAMODB
#
# Leave DYNAMODB_TABLE_NAME empty to use the local file-backed store.
# Set it (CDK outputs the name) to use real DynamoDB.
# ---------------------------------------------------------------------------
DYNAMODB_TABLE_NAME=

# Points the SDK at a DynamoDB other than the real service.
#
#   empty                    the real AWS endpoint for AWS_REGION
#   http://localhost:8000    DynamoDB Local in Docker (docker compose up -d)
#
# With this set you get the real database engine on your own machine: same
# queries, same indexes, same transactional writes as the deployed app. Leave
# it empty everywhere you deploy.
DYNAMODB_ENDPOINT=


# ---------------------------------------------------------------------------
# COGNITO
#
# Leave USER_POOL_ID empty to use local dev auth: the backend issues its own
# signed session tokens so you can sign up and log in without an AWS account.
# Local dev auth is refused outright when STAGE=prod.
# ---------------------------------------------------------------------------
USER_POOL_ID=
USER_POOL_CLIENT_ID=

# Only for a confidential app client. Stays server-side — it is used to compute
# the Cognito SECRET_HASH and must never be sent to the browser.
USER_POOL_CLIENT_SECRET=""

# Signs local-mode session tokens. Ignored entirely once Cognito is configured.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
LOCAL_AUTH_SECRET=


# ---------------------------------------------------------------------------
# S3 — voice recordings, documents, receipts, product images
#
# Objects are keyed vendors/{vendorId}/... and every presign is scoped to the
# caller's own vendorId server-side.
# ---------------------------------------------------------------------------
S3_BUCKET_NAME=

# How long a presigned upload/download URL stays valid, in seconds.
S3_PRESIGN_EXPIRY_SECONDS=900


# ---------------------------------------------------------------------------
# BEDROCK — transaction parsing, Shop Pulse narration, grounded search
#
# Set BEDROCK_ENABLED=true only after you have requested model access in the
# Bedrock console for the model below, in BEDROCK_REGION. Until then Vyapio
# uses its deterministic local parser and labels every result "Local parser".
#
# Bedrock is not available in every region that hosts the data plane, so the
# inference region is configured separately from AWS_REGION.
# ---------------------------------------------------------------------------
BEDROCK_ENABLED=false
BEDROCK_REGION=ap-south-1

# Cross-region inference profile id. The `apac.` prefix is required for the
# Asia-Pacific profile; use `us.` for the US profile.
BEDROCK_MODEL_ID=apac.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MAX_TOKENS=1600

# Bedrock Knowledge Base for semantic shop-memory retrieval. When empty, search
# falls back to the local deterministic retriever (which is still grounded —
# it only ever cites real rows from your shop).
BEDROCK_KNOWLEDGE_BASE_ID=


# ---------------------------------------------------------------------------
# BEDROCK AGENTCORE — agentic workflows
#
# When empty, the same tool set runs through an in-process planner with the
# identical permission checks, confirmation gate and AIAction audit trail.
# ---------------------------------------------------------------------------
AGENTCORE_RUNTIME_ARN=


# ---------------------------------------------------------------------------
# TRANSCRIBE — streaming voice
#
# When false, the browser's Web Speech API is used where available and the UI
# says so. Voice is never silently downgraded.
# ---------------------------------------------------------------------------
TRANSCRIBE_ENABLED=false
TRANSCRIBE_REGION=ap-south-1


# ---------------------------------------------------------------------------
# TEXTRACT — printed invoice / receipt extraction
#
# Printed documents only. Vyapio does not claim to read handwritten khata
# pages; see docs/ARCHITECTURE.md.
# ---------------------------------------------------------------------------
TEXTRACT_ENABLED=false
TEXTRACT_REGION=ap-south-1


# ---------------------------------------------------------------------------
# EVENTBRIDGE — asynchronous business events
#
# When empty, events are dispatched to in-process handlers instead, so the same
# downstream logic runs locally.
# ---------------------------------------------------------------------------
EVENT_BUS_NAME=


# ---------------------------------------------------------------------------
# NOTIFICATIONS
#
# NOTIFICATION_PROVIDER: mock | sns | whatsapp
#
#   mock      Records the message and reports it as "not delivered". Nothing
#             leaves the machine. This is the default and it never lies about
#             delivery.
#   sns       Real Amazon SNS publish. Requires SNS_TOPIC_ARN.
#   whatsapp  WhatsApp Business Cloud API. Requires the block below.
# ---------------------------------------------------------------------------
NOTIFICATION_PROVIDER=mock
SNS_TOPIC_ARN=

# --- WhatsApp Business Cloud API -------------------------------------------
#
# Server-side only. None of these reach the browser: the token is read in
# backend/src/services/notifications.ts and is returned by no route. Never
# copy any of it into a VITE_* variable, which is compiled into the bundle
# every visitor downloads.
#
# From Meta: App Dashboard -> WhatsApp -> API Setup.
#
#   ACCESS_TOKEN        A permanent System User token. The 24-hour test token
#                       on that page stops working the next day.
#   PHONE_NUMBER_ID     The sending number's id, not the number itself.
#   BUSINESS_ACCOUNT_ID The WABA id, shown on the same page.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0

# The approved template for a payment reminder.
#
# Meta only accepts a message the SHOP starts if it uses an approved template —
# free-form text works solely inside a 24-hour window the customer opens by
# writing first, which a shopkeeper chasing money does not have. With no
# template set, reminders are recorded and reported as not sent.
#
# Create it at: Meta Business Suite -> WhatsApp Manager -> Message templates,
# category "Utility".
WHATSAPP_PAYMENT_REMINDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE_CODE=en

# Which values fill the template's {{1}}, {{2}}, ... in order.
#
# Meta's placeholders are positional, so only the order matters. The default
# suits a body like: "Hi {{1}}, {{2}} is pending at {{3}}. Thank you!"
# Available names: customerName, amount, shopName, daysOverdue, dueDate
WHATSAPP_TEMPLATE_PARAMS=customerName,amount,shopName

# Require a customer to have opted in before anything is sent to them.
# Off by default so existing shops are unaffected.
WHATSAPP_REQUIRE_OPT_IN=false



# ---------------------------------------------------------------------------
# DEMO
# ---------------------------------------------------------------------------

# Enables the seeded "Sharma Stores" shop and its read-only demo login.
DEMO_MODE=true
DEMO_EMAIL=demo@vyapio.app
DEMO_PASSWORD="VyapioDemo#2024"
